# Copy to cluster.env and edit. Sourced by every script in scripts/.

# --- Cluster identity ---------------------------------------------------------
CLUSTER_NAME=ocp
BASE_DOMAIN=lab.internal
OCP_VERSION=4.22.22

# --- Host LAN side ------------------------------------------------------------
# The NIC and address other machines on your LAN use to reach this host.
# The address must not change: use a static IP or a DHCP reservation.
LAN_IF=enp3s0
LAN_IP=192.168.1.68
# Resolver the cluster uses for everything outside the cluster domain.
UPSTREAM_DNS=1.1.1.1

# --- Business network (libvirt NAT, node NIC enp1s0, becomes br-ex) -----------
# The only network. Node IPs, default route and DNS are here, so it carries
# everything: cluster traffic (etcd, pod overlay, internal API, machine config
# server), traffic leaving the cluster (image pulls, NTP, DNS) and MetalLB services.
# The host is at ${BUSINESS_SUBNET}.1: gateway (NAT to the LAN), DNS and DHCP for
# the nodes, and the internal load balancer behind api-int, api and *.apps.
# First three octets of a /24 not used anywhere on your LAN or VPNs.
# Must not overlap 10.128.0.0/14 or 172.30.0.0/16 (cluster networks below).
BUSINESS_SUBNET=192.168.127
BUSINESS_NET_NAME=ocp-business
BUSINESS_BRIDGE=virbr-ocp-biz

# --- Nodes --------------------------------------------------------------------
# Three control plane nodes that also run workloads (compact cluster).
# Node IPs are ${BUSINESS_SUBNET}.<octet>; the MACs are the DHCP reservation keys.
MASTER_0_OCTET=10
MASTER_1_OCTET=11
MASTER_2_OCTET=12
MASTER_0_MAC=52:54:00:12:6b:10
MASTER_1_MAC=52:54:00:12:6b:11
MASTER_2_MAC=52:54:00:12:6b:12

# Last-octet range reserved on the business network for MetalLB service IPs.
# It must not include any node octet.
BUSINESS_METALLB_FIRST_OCTET=100
BUSINESS_METALLB_LAST_OCTET=149

# --- Cluster-internal networks ------------------------------------------------
CLUSTER_NETWORK_CIDR=10.128.0.0/14
CLUSTER_NETWORK_HOST_PREFIX=23
SERVICE_NETWORK_CIDR=172.30.0.0/16

# --- VM sizing ----------------------------------------------------------------
# Per node (x3). Documented minimum: 4 vCPU / 16 GiB / 100 GiB. The nodes also run
# the ingress routers and your workloads, so go above the minimum if the host allows it.
VM_VCPUS=8
VM_MEM_GIB=16
VM_DISK_GIB=100
VM_DISK_DIR=/var/lib/libvirt/images/ocp

# --- Install inputs (keep these on the host, not in a synced folder) ----------
# Pull secret from https://console.redhat.com/openshift/install/pull-secret
PULL_SECRET_FILE=/root/pull-secret.json
SSH_PUB_KEY_FILE=/root/.ssh/id_ed25519.pub
WORK_DIR=/root/ocp-install
