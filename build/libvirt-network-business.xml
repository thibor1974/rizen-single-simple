<network>
  <name>ocp-business</name>
  <!-- The only network: machine network and the cluster's way out, NAT to the host's LAN.
       To use a real business network instead, bridge a physical NIC or VLAN here
       and give the nodes that network's gateway and DNS. -->
  <forward mode='nat'>
    <nat>
      <port start='1024' end='65535'/>
    </nat>
  </forward>
  <bridge name='virbr-ocp-biz' stp='on' delay='0' zone='libvirt'/>
  <!-- DNS and DHCP are served by ocp-dnsmasq@business, so libvirt must not start its own. -->
  <dns enable='no'/>
  <ip address='192.168.127.1' netmask='255.255.255.0'/>
</network>
