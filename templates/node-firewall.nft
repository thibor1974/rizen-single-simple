# Managed by MachineConfig 99-${MC_ROLE}-node-firewall.
#
# Business (enp2s0, bridged into br-ex by OVN-Kubernetes): the machine network.
#   Connections to the node itself are accepted only from the other nodes and the
#   host's internal load balancer: etcd, overlay, kubelet, internal API, machine
#   config server. Anyone else on the business side (clients, backends, the gateway's
#   far side) is refused SSH, the API, the default ingress and every other host
#   service. MetalLB and NodePort traffic is translated to pods before it reaches
#   this hook, and replies to the node's own connections pass.
#
# Management (enp1s0): admin access only. Allowed: ${NFT_MGMT_DESCRIPTION}.
#   Everything else (etcd, kubelet, machine config server...) is refused, and
#   nothing is routed in or out, so pods cannot use this network.
table inet node_filter
delete table inet node_filter
table inet node_filter {
	set cluster_sources {
		type ipv4_addr
		elements = { ${NFT_CLUSTER_SOURCES} }
	}

	chain input {
		type filter hook input priority filter; policy accept;
		iifname { "br-ex", "enp2s0" } jump business_in
		iifname "enp1s0" jump management_in
	}

	chain business_in {
		ct state established,related accept
		meta l4proto icmp accept
		ip saddr @cluster_sources accept comment "cluster traffic"
		ct status dnat accept comment "service traffic sent on to a local endpoint"
		tcp dport { 22, 80, 443, 6443, 22623 } counter drop comment "management services from outside the cluster"
		counter drop comment "any other host service from outside the cluster"
	}

	chain management_in {
		ct state established,related accept
		meta l4proto icmp accept
		tcp dport { ${NFT_MGMT_PORTS} } accept
		counter drop comment "not a management service"
	}

	chain forward {
		type filter hook forward priority filter; policy accept;
		iifname "enp1s0" counter drop comment "nothing is routed in from management"
		oifname "enp1s0" counter drop comment "nothing is routed out to management"
	}
}
