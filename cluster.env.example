# Copy to cluster.env and edit. Sourced by every script in scripts/.

# --- Cluster identity ---------------------------------------------------------
CLUSTER_NAME=ocp
BASE_DOMAIN=lab.internal
OCP_VERSION=4.22.18

# --- Host LAN side ------------------------------------------------------------
# The NIC and address other machines on your LAN use to reach this host.
# The address must not change: use a static IP or a DHCP reservation.
LAN_IF=CHANGE_ME
LAN_IP=CHANGE_ME
# Resolver the cluster uses for everything outside the cluster domain.
UPSTREAM_DNS=1.1.1.1

# --- Business network (libvirt NAT, node NIC enp2s0, becomes br-ex) -----------
# The machine network. Node IPs, default route and DNS are here, so it carries all
# cluster traffic (etcd, pod overlay, internal API, machine config server) and all
# traffic leaving the cluster (image pulls, NTP, DNS, EgressIP), plus MetalLB.
# The host is at ${BUSINESS_SUBNET}.1: gateway (NAT to the LAN), DNS and DHCP for
# the nodes, and the internal load balancer behind api-int, api and *.apps.
# First three octets of a /24 not used anywhere on your LAN or VPNs.
# Must not overlap 10.128.0.0/14 or 172.30.0.0/16 (cluster networks below).
BUSINESS_SUBNET=192.168.127
BUSINESS_NET_NAME=ocp-business
BUSINESS_BRIDGE=virbr-ocp-biz

# --- Management network (isolated libvirt bridge, node NIC enp1s0) ------------
# Dedicated to admin access: node SSH, the API and the default ingress (web
# console). Static addresses, no default route, no DNS, no way out: nodes only
# answer on it. LAN admins reach it through HAProxy on the host (LAN_IP), which
# is at ${MGMT_SUBNET}.1. First three octets of a /24 that differs from
# BUSINESS_SUBNET and is not used on your LAN or VPNs.
MGMT_SUBNET=192.168.126
MGMT_NET_NAME=ocp-mgmt
MGMT_BRIDGE=virbr-ocp-mgmt

# --- Nodes --------------------------------------------------------------------
# Each node's last octet is the same on both networks, e.g. master-0 is
# ${BUSINESS_SUBNET}.10 and ${MGMT_SUBNET}.10. Business MACs are DHCP reservation
# keys. NIC order is fixed: management is enp1s0, business is enp2s0.
MASTER_0_OCTET=10
MASTER_1_OCTET=11
MASTER_2_OCTET=12
INFRA_0_OCTET=20
MASTER_0_BUSINESS_MAC=52:54:00:12:6b:10
MASTER_1_BUSINESS_MAC=52:54:00:12:6b:11
MASTER_2_BUSINESS_MAC=52:54:00:12:6b:12
INFRA_0_BUSINESS_MAC=52:54:00:12:6b:20
MASTER_0_MGMT_MAC=52:54:00:12:6a:10
MASTER_1_MGMT_MAC=52:54:00:12:6a:11
MASTER_2_MGMT_MAC=52:54:00:12:6a:12
INFRA_0_MGMT_MAC=52:54:00:12:6a:20

# Last-octet ranges reserved on the business network, for MetalLB service IPs
# and for EgressIP objects (hosted by infra-0). They must not overlap each other
# or any node octet.
BUSINESS_METALLB_FIRST_OCTET=100
BUSINESS_METALLB_LAST_OCTET=149
BUSINESS_EGRESS_FIRST_OCTET=150
BUSINESS_EGRESS_LAST_OCTET=199

# --- Cluster-internal networks ------------------------------------------------
CLUSTER_NETWORK_CIDR=10.128.0.0/14
CLUSTER_NETWORK_HOST_PREFIX=23
SERVICE_NETWORK_CIDR=172.30.0.0/16

# --- VM sizing ----------------------------------------------------------------
# Masters (x3). Documented minimum: 4 vCPU / 16 GiB / 100 GiB. They also run the
# default ingress and your workloads, so go above the minimum if the host allows it.
VM_VCPUS=8
VM_MEM_GIB=24
VM_DISK_GIB=200
# Infra node (x1): MetalLB speaker and EgressIP host.
# Documented worker minimum: 2 vCPU / 8 GiB / 100 GiB. It is tainted, so it runs
# no user workloads.
INFRA_VCPUS=4
INFRA_MEM_GIB=8
INFRA_DISK_GIB=100
VM_DISK_DIR=/var/lib/libvirt/images/ocp

# --- Install inputs (keep these on the host, not in a synced folder) ----------
# Pull secret from https://console.redhat.com/openshift/install/pull-secret
PULL_SECRET_FILE=/root/pull-secret.json
SSH_PUB_KEY_FILE=/root/.ssh/id_ed25519.pub
WORK_DIR=/root/ocp-install
